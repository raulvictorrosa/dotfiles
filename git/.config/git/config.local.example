[user]
	name = Your Name
	email = your@email.com

# Optional: route specific directories to a different identity (e.g. work vs
# personal projects). Each target file is its own untracked [user] block,
# same shape as this one — gitignored next to config.local.
# [includeIf "gitdir:~/some/personal/path/"]
# 	path = ~/.config/git/config-personal
# [includeIf "gitdir:~/some/work/path/"]
# 	path = ~/.config/git/config-work
