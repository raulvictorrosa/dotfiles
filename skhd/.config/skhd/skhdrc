# skhd configuration file
# https://github.com/jackielii/skhd.zig

# Use custom shell (skips interactive shell overhead)
.shell "/bin/zsh"

# cycle_app: open if closed, focus if in background, rotate windows if already focused,
# hide if it has a single window. Source: utils/CycleApp.swift (built into ~/.local/bin/skhd-utils by `mise run skhd-build`).
.define cycle_app : ~/.local/bin/skhd-utils cycle-app "{{1}}"

# ghostty_window(command, width, height): run <command> in its own Ghostty window titled <command>.
# Freshly opened: sized width x height, centered in the upper third. Already open: only focused,
# so a window you resized or maximized keeps its size.
# The title marks it: a command running elsewhere (Herdr, VS Code embed) must not count.
.define ghostty_window : sh -c ' \
  if pgrep -f "[g]hostty --title={{1}}" > /dev/null; then \
    ~/.local/bin/skhd-utils place-window Ghostty {{1}}; \
  else \
    open -n -a Ghostty --args --title={{1}} -e {{1}}; \
    ~/.local/bin/skhd-utils place-window Ghostty {{1}} {{2}} {{3}}; \
  fi'

# Application shortcuts
alt - 1: @cycle_app("Google Chrome")
alt - 2: @cycle_app("Visual Studio Code")
alt - 3: @cycle_app("Ghostty")
alt - 4: @cycle_app("Github Copilot")
alt - 5: @cycle_app("Microsoft Teams")
alt - 6: @cycle_app("Microsoft Outlook")
alt - 7: @cycle_app("Figma")

alt - return: @cycle_app("Herdr")
alt + shift - b: @cycle_app("Google Chrome")
alt + cmd + shift - b: open -na "Google Chrome" --args --incognito
alt + shift - f: @cycle_app("Finder")
alt + shift - m: "${XDG_CONFIG_HOME:-$HOME/.config}/skhd/scripts/music-picker.sh"
# 875x700 is tall enough for the whole LazyVim dashboard
alt + shift - n: @ghostty_window("nvim", "875", "700")
alt + shift - t: @ghostty_window("btop", "875", "600")

# command to restart skhd
# skhd --reload

