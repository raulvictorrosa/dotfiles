# skhd configuration file
# https://github.com/jackielii/skhd.zig

# Use custom shell (skips interactive shell overhead)
.shell "/bin/zsh"

# cycle_app: open if closed, focus if in background, rotate windows if already focused,
# hide if it has a single window. Source: scripts/cycle-app.swift (build command in its header).
.define cycle_app : ~/.config/skhd/scripts/cycle-app "{{1}}"

# Open Neovim in its own Ghostty window (875x700, tall enough for the whole LazyVim dashboard),
# or focus it if already open.
# The window title marks it: an nvim running elsewhere (Herdr, VS Code embed) must not count.
.define open_nvim : sh -c ' \
  pgrep -f "[g]hostty --title=nvim" > /dev/null || \
    open -n -a Ghostty --args --title=nvim -e nvim; \
  ~/.config/skhd/scripts/place-window Ghostty nvim 875 700'

# Application shortcuts
alt - 1: @cycle_app("Google Chrome")
alt - 2: @cycle_app("Visual Studio Code")
alt - 3: @cycle_app("Ghostty")
alt - 4: @cycle_app("Github Copilot")
alt - 5: @cycle_app("Microsoft Teams")
alt - 6: @cycle_app("Microsoft Outlook")
alt - 7: @cycle_app("Figma")

alt - return: @cycle_app("Herdr")
alt + shift - b: @cycle_app("Google Chrome")
alt + cmd + shift - b: open -na "Google Chrome" --args --incognito
alt + shift - f: @cycle_app("Finder")
alt + shift - m: ~/.config/skhd/scripts/music-picker.sh
alt + shift - n: @open_nvim
# btop in its own centered Ghostty window (875x600, upper third); place-window waits for the window
alt + shift - t : sh -c ' \
  pgrep -f "Ghostty.*btop" > /dev/null || \
    open -n -a Ghostty --args --title="btop" -e btop; \
  ~/.config/skhd/scripts/place-window Ghostty btop 875 600'

# command to restart skhd
# skhd --reload

