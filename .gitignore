.DS_Store

# Machine-local git identity — real file lives here now (parallel to
# config.local.example) so stow manages the symlink, but must never be committed
git/.config/git/config.local

tmux/.config/tmux/plugins/

zed/.config/zed/conversations/
zed/.config/zed/embeddings/
zed/.config/zed/prompts/
zed/.config/zed/.tmp*

# Copilot - skill folders are large, lock file is enough
copilot/.agents/skills/*/
# Hooks scripts may contain telemetry endpoints - review before committing
