.DS_Store

# Machine-local git identity — real files live here now (parallel to
# config-example.local) so stow manages the symlinks, but must never be
# committed. config-example.local itself ends in .local too (it's the
# template), hence the negation below to keep it tracked.
git/.config/git/*.local
!git/.config/git/config-example.local

tmux/.config/tmux/plugins/

# antidote's compiled plugin bundle — regenerated from .zsh_plugins.txt
zsh/.config/zsh/.zsh_plugins.zsh

# stray history file /etc/zshrc creates at $ZDOTDIR before .zshrc reasserts HISTFILE
zsh/.config/zsh/.zsh_history

# compiled completion cache, regenerated per-machine by compinit
zsh/.config/zsh/.zcompcache/

# per-terminal session/history state, not config
zsh/.config/zsh/.zsh_sessions/

zed/.config/zed/conversations/
zed/.config/zed/embeddings/
zed/.config/zed/prompts/
zed/.config/zed/.tmp*
